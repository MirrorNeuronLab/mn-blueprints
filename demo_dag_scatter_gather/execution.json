          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_scatter_gather",
            "MN_WORKFLOW_STEP_ID": "collect",
            "MN_DEMO_FINAL_STEP": "1",
            "MN_SCATTER_EXPECTED_ITEMS": "5"
