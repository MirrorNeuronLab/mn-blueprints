{
  "$schema": "https://mirrorneuron.dev/schemas/blueprint/v1/manifest.schema.json",
  "id": "ros_amr_controller",
  "name": "ROS AMR Controller",
  "version": "1.0.0",
  "description": "Give it a warehouse scenario and it runs a long-lived ROS 2 TurtleBot simulation on a joined NVIDIA node, with a browser control room, bounded natural-language MCP controls, and run evidence written to the configured output folder without exposing an arbitrary host input folder.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "extensions": {
    "mn.airgap": {
      "file": "extensions/airgap.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    }
  }
}
