{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "agents": {
    "edges": [
      {
        "edge_id": "analyze_to_report",
        "from_node": "analyze",
        "message_type": "analysis_ready",
        "to_node": "report"
      },
      {
        "edge_id": "report_to_sink",
        "from_node": "report",
        "message_type": "final_result",
        "to_node": "report_sink"
      }
    ],
    "entrypoints": [
      "analyze"
    ],
    "nodes": [
      {
        "alias": "analyze",
        "display_name": "Bundled Model Analyzer",
        "node_id": "analyze",
        "role": "root_coordinator",
        "uses": "demo-airgap.agent.analyzer@1",
        "with": {
          "environment": {
            "MN_BLUEPRINT_ID": "demo_air_gapped",
            "MN_LLM_API_BASE": "http://127.0.0.1:12434/engines/v1",
            "MN_LLM_BACKEND": "llama.cpp",
            "MN_LLM_CONTEXT_SIZE": "4096",
            "MN_LLM_MODEL": "demo-air-gapped/gemma4-e2b:latest",
            "MN_LLM_PROVIDER": "docker_model_runner",
            "MN_WORKFLOW_STEP_ID": "analyze"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "analysis_ready",
          "safe_to_retry": true,
          "script": "worker.py",
          "timeout_seconds": 180,
          "upload_path": "worker"
        }
      },
      {
        "alias": "report",
        "display_name": "Bundled Offline Reporter",
        "node_id": "report",
        "role": "worker",
        "uses": "demo-airgap.agent.reporter@1",
        "with": {
          "environment": {
            "MN_DEMO_FINAL_STEP": "1",
            "MN_BLUEPRINT_ID": "demo_air_gapped",
            "MN_WORKFLOW_STEP_ID": "report"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "final_result",
          "safe_to_retry": true,
          "script": "worker.py",
          "timeout_seconds": 30,
          "upload_path": "worker"
        }
      },
      {
        "agent_type": "aggregator",
        "alias": "result_sink",
        "config": {
          "complete_on_message": true,
          "complete_run": true,
          "terminal_sink": true
        },
        "node_id": "report_sink",
        "role": "result_sink",
        "type": "reduce"
      }
    ],
    "schema": "mn.agents.communication_graph/v1"
  },
  "job_name": "demo-air-gapped",
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "disk": {
      "min_gb": 12
    },
    "gpu": {
      "min_count": 0
    },
    "memory": {
      "min_gb": 8
    }
  },
  "runtime": {
    "bindings": {
      "analyze": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "analyze",
            "model": "primary",
            "role": "Analyze the local note with the bundled model."
          }
        ]
      },
      "report": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "report",
            "role": "Write the final local report."
          }
        ]
      }
    },
    "initial_inputs": {
      "analyze": [
        {
          "note": "A field gateway reported intermittent latency after a cache rollout. No data left the site. Operators want likely causes and three safe checks."
        }
      ]
    },
    "models": {
      "primary": {
        "backend": "llama.cpp",
        "context_size": 4096,
        "provider": "docker_model_runner",
        "required": true,
        "runtime_model": "demo-air-gapped/gemma4-e2b:latest",
        "source": {
          "format": "gguf",
          "license_path": "models/gemma4-e2b/LICENSE",
          "mmproj_path": "models/gemma4-e2b/model.mmproj",
          "path": "models/gemma4-e2b/gemma-4-E2B-it-UD-Q4_K_XL.gguf",
          "type": "payload"
        }
      }
    },
    "store": {
      "path": "~/.mn/runs/${run_id}",
      "type": "local_run_store"
    }
  },
  "mode": "explicit"
}
