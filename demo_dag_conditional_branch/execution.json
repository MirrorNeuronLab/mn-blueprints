{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "agents": {
    "edges": [
      {
        "conditions": {
          "expr": "${payload.outputs.selected_branch} == \"low_risk\""
        },
        "edge_id": "route_to_low_risk",
        "from_node": "route",
        "message_type": "route_done",
        "routing_mode": "first_match",
        "to_node": "low_risk"
      },
      {
        "conditions": {
          "expr": "${payload.outputs.selected_branch} == \"high_risk\""
        },
        "edge_id": "route_to_high_risk",
        "from_node": "route",
        "message_type": "route_done",
        "routing_mode": "first_match",
        "to_node": "high_risk"
      },
      {
        "edge_id": "low_risk_to_join",
        "from_node": "low_risk",
        "message_type": "low_risk_done",
        "to_node": "join"
      },
      {
        "edge_id": "high_risk_to_join",
        "from_node": "high_risk",
        "message_type": "high_risk_done",
        "to_node": "join"
      },
      {
        "edge_id": "join_to_report_sink",
        "from_node": "join",
        "message_type": "final_result",
        "to_node": "report_sink"
      }
    ],
    "entrypoints": [
      "route"
    ],
    "nodes": [
      {
        "agent_type": "executor",
        "alias": "route",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 60000,
          "command": [
            "python3.11",
            "worker.py"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_conditional_branch",
            "MN_WORKFLOW_STEP_ID": "route"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "route_done",
          "pool": "default",
          "pool_slots": 1,
          "retry_backoff_ms": 100,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "timeout_seconds": 60,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        },
        "display_name": "Route",
        "node_id": "route",
        "resources": {
          "cpu_cores": 0.1,
          "disk_mb": 4,
          "memory_mb": 32,
          "runtime_driver": "host_local"
        },
        "role": "root_coordinator",
        "type": "generic"
      },
      {
        "agent_type": "executor",
        "alias": "low_risk",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 60000,
          "command": [
            "python3.11",
            "worker.py"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_conditional_branch",
            "MN_WORKFLOW_STEP_ID": "low_risk"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "low_risk_done",
          "pool": "default",
          "pool_slots": 1,
          "retry_backoff_ms": 100,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "timeout_seconds": 60,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        },
        "display_name": "Low Risk",
        "node_id": "low_risk",
        "resources": {
          "cpu_cores": 0.1,
          "disk_mb": 4,
          "memory_mb": 32,
          "runtime_driver": "host_local"
        },
        "role": "worker",
        "type": "generic"
      },
      {
        "agent_type": "executor",
        "alias": "high_risk",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 60000,
          "command": [
            "python3.11",
            "worker.py"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_conditional_branch",
            "MN_WORKFLOW_STEP_ID": "high_risk"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "high_risk_done",
          "pool": "default",
          "pool_slots": 1,
          "retry_backoff_ms": 100,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "timeout_seconds": 60,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        },
        "display_name": "High Risk",
        "node_id": "high_risk",
        "resources": {
          "cpu_cores": 0.1,
          "disk_mb": 4,
          "memory_mb": 32,
          "runtime_driver": "host_local"
        },
        "role": "worker",
        "type": "generic"
      },
      {
        "agent_type": "executor",
        "alias": "join",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 60000,
          "command": [
            "python3.11",
            "worker.py"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_conditional_branch",
            "MN_WORKFLOW_STEP_ID": "join",
            "MN_DEMO_FINAL_STEP": "1"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": "final_result",
          "pool": "default",
          "pool_slots": 1,
          "retry_backoff_ms": 100,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "timeout_seconds": 60,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        },
        "display_name": "Join",
        "node_id": "join",
        "resources": {
          "cpu_cores": 0.1,
          "disk_mb": 4,
          "memory_mb": 32,
          "runtime_driver": "host_local"
        },
        "role": "worker",
        "type": "generic"
      },
      {
        "agent_type": "aggregator",
        "alias": "result_sink",
        "config": {
          "complete_on_message": true,
          "complete_run": true,
          "terminal_sink": true
        },
        "node_id": "report_sink",
        "role": "result_sink",
        "type": "reduce"
      }
    ],
    "schema": "mn.agents.communication_graph/v1"
  },
  "job_name": "demo-dag-conditional-branch",
  "policies": {
    "recovery_mode": "local_restart",
    "restart": {
      "attempts": 2,
      "delay_function": "constant",
      "delay_ms": 100,
      "interval_ms": 60000,
      "max_delay_ms": 100,
      "mode": "fail"
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 0.1
    },
    "disk": {
      "min_gb": 0.01
    },
    "gpu": {
      "min_count": 0
    },
    "memory": {
      "min_gb": 0.05
    }
  },
  "runtime": {
    "bindings": {
      "high_risk": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "high_risk",
            "role": "Run this workflow step."
          }
        ]
      },
      "join": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "join",
            "role": "Run this workflow step."
          }
        ]
      },
      "low_risk": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "low_risk",
            "role": "Run this workflow step."
          }
        ]
      },
      "route": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "route",
            "role": "Run this workflow step."
          }
        ]
      }
    },
    "initial_inputs": {
      "route": [
        {
          "records": [
            1,
            2,
            3,
            4,
            5
          ],
          "scenario": "demo_dag_conditional_branch",
          "seed": 42
        }
      ]
    },
    "store": {
      "path": "~/.mn/runs/${run_id}",
      "type": "local_run_store"
    },
    "workflow_control": {
      "enabled": true,
      "liveness": {
        "event": "agent_beacon",
        "interval_ms": 1000,
        "missed_action": "fail_attempt",
        "required": false,
        "timeout_ms": 5000
      },
      "schema_version": "mn.workflow.runtime_control.v1",
      "source_of_truth": "workflow.steps",
      "state_ledger": {
        "delivery_semantics": "at_least_once_with_idempotency",
        "enabled": true,
        "message_ledger": true,
        "persisted_field": "workflow_state"
      }
    }
  },
  "mode": "explicit"
}
