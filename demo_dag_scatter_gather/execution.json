        "from_node": "scatter",
        "message_type": "scatter_done",
        "to_node": "worker"
      },
      {
        "edge_id": "worker_to_collect",
        "from_node": "worker",
        "message_type": "worker_done",
        "to_node": "collect"
      },
      {
        "edge_id": "collect_to_report_sink",
