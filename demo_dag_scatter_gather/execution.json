          "runtime_driver": "host_local"
        },
        "role": "root_coordinator",
        "type": "generic"
      },
      {
        "agent_type": "executor",
        "alias": "worker",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 300000,
          "command": [
            "python3.11",
            "worker.py"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "demo_dag_scatter_gather",
            "MN_WORKFLOW_STEP_ID": "worker"
          },
          "idempotent": true,
          "max_attempts": 1,
          "output_message_type": null,
          "pool": "default",
          "pool_slots": 1,
          "retry_backoff_ms": 100,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "timeout_seconds": 300,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        },
        "display_name": "Worker",
        "node_id": "worker",
        "resources": {
          "cpu_cores": 0.1,
          "disk_mb": 4,
          "memory_mb": 32,
          "runtime_driver": "host_local"
        },
        "role": "worker",
        "type": "generic"
      },
      {
        "agent_type": "executor",
        "alias": "collect",
        "config": {
          "agent_beacon_required": false,
          "beacon_enabled": true,
          "beacon_interval_ms": 1000,
          "beacon_missed_action": "fail_attempt",
          "beacon_timeout_ms": 300000,
          "command": [
            "python3.11",
            "worker.py"
