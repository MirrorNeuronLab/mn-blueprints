{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "dynamic": {
    "enabled": false
  },
  "edges": [
    {
      "accepts": [
        "done"
      ],
      "from": "serve",
      "id": "serve_to_close",
      "required": true,
      "to": "close"
    }
  ],
  "entrypoint": "serve",
  "execution": {
    "max_parallel_steps": 4,
    "strategy": "serial"
  },
  "mode": "static_dag",
  "sink": "close",
  "source": "serve",
  "steps": [
    {
      "action": "run_worker",
      "control": {
        "failure_policy": "fail_workflow",
        "required": true,
        "retry": {
          "backoff_seconds": 0.1,
          "max_attempts": 1
        },
        "timeout_seconds": 30
      },
      "emits": [
        "serve_done"
      ],
      "goal": "Run the serve stage.",
      "id": "serve",
      "kind": "task",
      "label": "Serve",
      "run": "serve"
    },
    {
      "action": "run_worker",
      "control": {
        "failure_policy": "fail_workflow",
        "required": true,
        "retry": {
          "backoff_seconds": 0.1,
          "max_attempts": 1
        },
        "timeout_seconds": 10
      },
      "emits": [
        "close_done"
      ],
      "goal": "Run the close stage.",
      "id": "close",
      "kind": "task",
      "label": "Close",
      "run": "close"
    }
  ],
  "workflow_id": "demo_canary_deployment_v2"
}
