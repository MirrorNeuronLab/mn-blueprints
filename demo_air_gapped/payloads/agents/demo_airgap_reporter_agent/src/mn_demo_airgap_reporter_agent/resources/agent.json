{
  "agent_id": "demo-airgap.agent.reporter",
  "behavior": {
    "delegation": {
      "allow_recursive": false,
      "enabled": false,
      "inherits_tools": false
    },
    "emits": {
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "mime_type": "application/json",
          "schema": "mn.blueprint.final_artifact.v1"
        }
      ],
      "events": [
        "airgap_report_written",
        "agent_completed",
        "agent_failed"
      ],
      "messages": [
        {
          "fallback_message_type": "final_result",
          "message_type": "config.output_message_type"
        }
      ]
    },
    "lifecycle_events": {
      "failure": [
        "agent_started",
        "agent_failed"
      ],
      "success": [
        "agent_started",
        "agent_completed"
      ]
    },
    "required_config": [
      "command",
      "runner_module",
      "upload_path",
      "workdir"
    ],
    "routing": {
      "transitions": [
        {
          "then": {
            "reason": "report_complete",
            "type": "terminate"
          },
          "when": {
            "type": "always"
          }
        }
      ]
    },
    "schema_version": "mn.agent.behavior.v1",
    "summary": "Normalize the local model response and write standard run artifacts."
  },
  "defaults": {
    "agent_beacon_required": true,
    "agent_type": "executor",
    "beacon_enabled": true,
    "beacon_interval_ms": 15000,
    "beacon_missed_action": "fail_attempt",
    "beacon_timeout_ms": 45000,
    "from": "base",
    "no_auto_providers": true,
    "no_keep": true,
    "pool": "default",
    "pool_slots": 1,
    "runner_module": "MirrorNeuron.Runner.HostLocal",
    "tty": false,
    "type": "generic",
    "workdir_template": "/sandbox/job/{upload_path}"
  },
  "description": "Blueprint-owned local reporter executor.",
  "input_spec": "input.spec.json",
  "inputs": {
    "optional": [
      "role",
      "output_message_type",
      "environment",
      "timeout_seconds",
      "max_attempts",
      "safe_to_retry",
      "idempotent"
    ],
    "required": [
      "upload_path"
    ],
    "required_unless_command": [
      "script"
    ]
  },
  "kind": "executor",
  "output_spec": "output.spec.json",
  "package_kind": "runtime_node",
  "payloads": "payloads",
  "provides": [
    "runtime_shape",
    "rendered_manifest_node",
    "standard_run_artifacts"
  ],
  "python": {
    "definition_loader": "load_agent_definition",
    "distribution": "mn-demo-airgap-reporter-agent",
    "factory": "create_agent",
    "module": "mn_demo_airgap_reporter_agent"
  },
  "renders_to": "manifest.nodes[]",
  "schema_version": "mn.agent.package.v1",
  "template_category": "data",
  "template_id": "demo-airgap.agent.reporter",
  "version": 1
}
