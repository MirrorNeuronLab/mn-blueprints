{
  "backpressure": {
    "drop_policy": "block",
    "max_concurrency": 4,
    "max_events_per_second": 20,
    "queue_size": 32
  },
  "budgets": {
    "max_disk_mb": 8,
    "max_llm_calls": 0,
    "max_llm_tokens": 0,
    "max_runtime_seconds": 20
  },
  "capabilities": {
    "optional": [],
    "required": [
      "filesystem.write"
    ]
  },
  "demo": {
    "primary_feature": "Bounded dynamic DAG patching"
  },
  "determinism": {
    "enabled": true,
    "seed_field": "seed"
  },
  "execution_model": [
    "inspect_context",
    "apply_bounded_graph_patch",
    "run_admitted_templates",
    "write_report"
  ],
  "human_control": {
    "enabled": false,
    "mode": "disabled"
  },
  "identity": {
    "blueprint_id": "demo_dynamic_workflow",
    "name": "Dynamic Workflow"
  },
  "inputs": {
    "adapter": "mock",
    "description": "Bundled deterministic evidence-gap input.",
    "env": "MN_BLUEPRINT_INPUT_JSON",
    "path": null,
    "payload": {
      "evidence_gap": true,
      "question": "Is the bounded dynamic DAG runtime working?",
      "seed": 42
    }
  },
  "interfaces": {
    "input_adapters": [
      "mock",
      "json",
      "file",
      "env_json"
    ],
    "output_adapters": [
      "local_run_store"
    ],
    "run_artifacts": [
      "run.json",
      "config.json",
      "inputs.json",
      "events.jsonl",
      "errors.jsonl",
      "timeline.jsonl",
      "observability_summary.json",
      "result.json",
      "final_artifact.json"
    ]
  },
  "llm": {
    "agents": {},
    "enabled": false,
    "mock_mode": "fake"
  },
  "logging": {
    "events_jsonl": true,
    "level": "INFO",
    "logs_jsonl": true,
    "redact_env_secrets": true
  },
  "metadata": {
    "category": "Workflow DAG",
    "customizable_for": "Runtime training and adaptive workflow experiments.",
    "problem_solved": "Safely add bounded follow-up work after runtime evidence changes.",
    "target_users": "MirrorNeuron developers and runtime evaluators."
  },
  "mode": "mock",
  "outputs": {
    "adapter": "local_run_store",
    "required_artifacts": [
      "run.json",
      "config.json",
      "inputs.json",
      "events.jsonl",
      "errors.jsonl",
      "timeline.jsonl",
      "observability_summary.json",
      "result.json",
      "final_artifact.json"
    ],
    "run_root": "~/.mn/runs",
    "write_run_store": true
  },
  "privacy": {
    "default_classification": "internal",
    "redact_fields": [
      "api_key",
      "token",
      "password",
      "authorization"
    ]
  },
  "real_adapters": {
    "environment_json": {
      "adapter": "env_json",
      "env": "MN_BLUEPRINT_INPUT_JSON"
    },
    "inline_json": {
      "adapter": "json",
      "payload": {}
    },
    "input_file": {
      "adapter": "file",
      "path": null
    }
  },
  "resources": {
    "enabled": true,
    "gpu_enabled": false
  },
  "schemas": {
    "config": "mn.blueprint.config.v1",
    "events": "mn.blueprint.events.v1",
    "final_artifact": "mn.blueprint.final_artifact.v1",
    "inputs": "mn.blueprint.inputs.v1"
  },
  "simulation": {
    "deterministic": true,
    "enabled": true,
    "seed_field": "seed"
  },
  "standard_version": "1.0",
  "state": {
    "enabled": false,
    "resume_mode": "none"
  },
  "triggers": {
    "schedule": null,
    "sources": [],
    "type": "manual"
  },
  "web_ui": {
    "enabled": false,
    "input": {
      "adapter": "none"
    },
    "output": {
      "adapter": "none"
    }
  }
}
