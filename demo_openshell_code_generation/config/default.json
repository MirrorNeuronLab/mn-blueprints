{
  "identity": {
    "blueprint_id": "demo_openshell_code_generation"
  },
  "mode": "live",
  "opencode": {
    "model": "opencode/muse-spark-1.3-contributor-free",
    "mode": "generate",
    "folder": "project",
    "prompt_file": "prompts/pizza.md",
    "timeout_seconds": 600
  },
  "inputs": {
    "adapter": "json",
    "payload": {
      "task": "generate_pizza_page"
    }
  },
  "budgets": {
    "max_runtime_seconds": 660,
    "max_disk_mb": 512
  },
  "logging": {
    "level": "INFO",
    "redact_env_secrets": true
  },
  "outputs": {
    "adapter": "local_run_store",
    "folder_path": "~/Downloads/demo_openshell_code_generation",
    "write_run_store": true
  }
}
