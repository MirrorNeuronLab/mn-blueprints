  "apiVersion": "mn.workflow/v2",
  "contract": {
    "events": {
      "stream": "events.jsonl",
      "types": [
        "workflow_graph_patch_applied",
        "workflow_step_triggered",
        "workflow_step_completed",
        "run_completed",
        "run_failed"
      ]
    },
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "scenario": {
        "description": "Deterministic evidence-gap scenario.",
        "required": true,
        "type": "object"
      }
    },
    "outputs": {
      "artifacts": [
        {
          "artifact_id": "run_json",
          "path": "run.json"
        },
        {
          "artifact_id": "config_json",
          "path": "config.json"
        },
        {
          "artifact_id": "inputs_json",
          "path": "inputs.json"
        },
        {
          "artifact_id": "events_jsonl",
          "path": "events.jsonl"
        },
        {
          "artifact_id": "errors_jsonl",
          "path": "errors.jsonl"
        },
        {
          "artifact_id": "timeline_jsonl",
          "path": "timeline.jsonl"
        },
        {
          "artifact_id": "observability_summary_json",
          "path": "observability_summary.json"
        },
        {
          "artifact_id": "result_json",
          "path": "result.json"
        },
        {
          "artifact_id": "final_artifact_json",
          "path": "final_artifact.json"
        }
      ],
      "primary": {
        "id": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact.v1",
        "type": "final_artifact"
      },
      "profile": "standard_run_store"
    },
    "privacy": {
      "classification": "internal"
    },
    "summary": "Safely insert admitted follow-up work when runtime evidence is incomplete.",
    "users": [
      "MirrorNeuron developers and runtime evaluators."
    ]
  },
  "description": "Safely insert admitted follow-up work when runtime evidence is incomplete.",
  "id": "demo_dynamic_workflow",
  "input_validation": {
    "rules": []
  },
  "job_name": "demo-dynamic-workflow",
  "kind": "Workflow",
  "license": "LICENSE.md",
  "manifest_version": "1.0",
  "metadata": {
    "blueprint_id": "demo_dynamic_workflow",
    "category": "Workflow DAG",
    "customizable_for": "Runtime training and adaptive workflow experiments.",
    "description": "Safely insert admitted follow-up work when runtime evidence is incomplete.",
    "input_contract": {
      "optional_inputs": [
        {
          "description": "Set false to retain the fixed direct path.",
          "example": false,
          "name": "evidence_gap",
          "type": "boolean"
        }
      ],
      "privacy_classification": "internal",
      "required_inputs": [
        {
          "description": "Deterministic demo question.",
          "name": "question",
          "type": "string"
        }
      ],
      "resolved_artifact": "inputs.json",
      "schema_version": "mn.blueprint.input_contract.v1",
      "supported_adapters": [
        "mock",
        "json",
        "file",
        "env_json"
      ],
      "validation_rules": []
    },
    "interfaces": {
      "config": "config/default.json",
      "payloads": "payloads/"
    },
    "name": "Dynamic Workflow",
    "output": "A final artifact containing fixed and inserted paths, graph revision, verified evidence, and patch identity.",
    "output_contract": "mn.blueprint.final_artifact.v1",
    "problem_solved": "Safely add bounded follow-up work after runtime evidence changes.",
    "quick_test": {
      "command": "mn blueprint run --folder . --offline --fake-llm --detached",
      "enabled": true,
      "expected_seconds_warm": 10
    },
    "runtime_features": [
      "Bounded dynamic DAG patching"
    ],
    "simulation_type": "Deterministic synthetic runtime scenario.",
    "standard": "1.0",
    "target_user": "MirrorNeuron developers and runtime evaluators."
  },
  "name": "Dynamic Workflow",
  "policies": {
    "recovery_mode": "local_restart",
    "restart": {
      "attempts": 2,
      "delay_function": "constant",
      "delay_ms": 100,
      "interval_ms": 60000,
      "max_delay_ms": 100,
      "mode": "fail"
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 0.1
    },
    "disk": {
      "min_gb": 0.01
    },
    "gpu": {
      "min_count": 0
    },
    "memory": {
      "min_gb": 0.05
    }
  },
  "runtime": {
    "bindings": {
      "followup_research": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "followup_research_worker",
            "role": "Execute admitted follow-up research instances."
          }
        ]
      },
      "inspect_context": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "inspect_context",
            "role": "Inspect runtime context and control the adaptive region."
          }
        ]
      },
      "verify_evidence": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "verify_evidence_worker",
            "role": "Verify admitted evidence instances."
          }
        ]
      },
      "write_report": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "write_report",
            "role": "Write the final deterministic report."
          }
        ]
      }
    },
    "initial_inputs": {
      "inspect_context": [
        {
          "evidence_gap": true,
          "question": "Is the bounded dynamic DAG runtime working?",
          "scenario": "demo_dynamic_workflow",
          "seed": 42
        }
      ]
    },
    "store": {
      "path": "~/.mn/runs/${run_id}",
      "type": "local_run_store"
    },
    "workflow_control": {
      "enabled": true,
      "liveness": {
        "event": "agent_beacon",
        "interval_ms": 1000,
        "missed_action": "fail_attempt",
        "required": false,
        "timeout_ms": 5000
      },
      "schema_version": "mn.workflow.runtime_control.v1",
      "source_of_truth": "workflow.steps",
      "state_ledger": {
        "delivery_semantics": "at_least_once_with_idempotency",
        "enabled": true,
        "message_ledger": true,
        "persisted_field": "workflow_state"
      }
    }
  },
  "standard_version": "1.0",
  "term": "TERM.md",
  "version": 1,
  "workflow": {
    "dynamic": {
      "apply_at": "between_steps",
      "enabled": true,
      "limits": {
        "max_active_steps": 128,
        "max_instance_input_bytes": 32768,
        "max_operations_per_patch": 64,
        "max_patches": 64
      },
      "regions": [
        {
          "controller": "inspect_context",
          "exit": "write_report",
          "id": "research_followups",
          "mutable_edges": [
            "inspect_to_report"
          ],
          "strategy": "replace_path",
          "templates": [
            "followup_research",
            "verify_evidence"
          ]
        }
      ],
      "templates": {
        "followup_research": {
          "agent_id": "followup_research_worker",
          "control": {
            "failure_policy": "fail_workflow",
            "required": true,
            "retry": {
              "backoff_seconds": 0.1,
              "max_attempts": 1
            },
            "timeout_seconds": 60
          },
          "id": "followup_research",
          "label": "Follow-up Research",
          "run": "followup_research"
        },
        "verify_evidence": {
          "agent_id": "verify_evidence_worker",
          "control": {
            "failure_policy": "fail_workflow",
            "required": true,
            "retry": {
              "backoff_seconds": 0.1,
              "max_attempts": 1
            },
            "timeout_seconds": 60
          },
          "id": "verify_evidence",
          "label": "Verify Evidence",
          "run": "verify_evidence"
        }
      }
    },
    "edges": [
      {
        "accepts": [
          "done"
        ],
        "from": "inspect_context",
        "id": "inspect_to_report",
        "required": true,
        "to": "write_report"
      }
    ],
    "entrypoint": "inspect_context",
    "execution": {
      "max_parallel_steps": 4,
      "strategy": "serial"
    },
    "mode": "dynamic_dag",
    "schema": "mn.workflow.problem_graph/v1",
    "sink": "write_report",
    "source": "inspect_context",
    "steps": [
      {
        "action": "run_worker",
        "control": {
          "failure_policy": "fail_workflow",
          "required": true,
          "retry": {
            "backoff_seconds": 0.1,
            "max_attempts": 1
          },
          "timeout_seconds": 60
        },
        "emits": [
          "inspect_context_done"
        ],
        "goal": "Inspect runtime evidence and control the adaptive region.",
        "id": "inspect_context",
        "kind": "task",
        "label": "Inspect Context",
        "run": "inspect_context"
      },
      {
        "action": "run_worker",
        "control": {
          "failure_policy": "fail_workflow",
          "required": true,
          "retry": {
            "backoff_seconds": 0.1,
            "max_attempts": 1
          },
          "timeout_seconds": 60
        },
        "emits": [
          "final_result"
        ],
        "goal": "Write the final artifact from the resolved path.",
        "id": "write_report",
        "kind": "task",
        "label": "Write Report",
        "run": "write_report"
      }
    ],
    "workflow_id": "demo_dynamic_workflow_v2"
  }
}
