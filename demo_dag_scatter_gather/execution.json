  "job_name": "demo-dag-scatter-gather",
  "policies": {
    "recovery_mode": "local_restart",
    "restart": {
      "attempts": 2,
      "delay_function": "constant",
      "delay_ms": 100,
      "interval_ms": 60000,
      "max_delay_ms": 100,
      "mode": "fail"
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 0.1
    },
    "disk": {
      "min_gb": 0.01
    },
    "gpu": {
      "min_count": 0
    },
    "memory": {
      "min_gb": 0.05
    }
  },
  "runtime": {
    "bindings": {
      "collect": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "collect",
            "role": "Run this workflow step."
          }
        ]
      },
      "scatter": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "scatter",
            "role": "Run this workflow step."
          }
        ]
      },
      "worker": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "worker",
            "role": "Run this workflow step."
          }
        ]
      }
    },
    "initial_inputs": {
      "scatter": [
        {
          "records": [
            1,
            2,
            3,
            4,
            5
          ],
          "scenario": "demo_dag_scatter_gather",
          "seed": 42
        }
      ]
    },
    "store": {
      "path": "~/.mn/runs/${run_id}",
      "type": "local_run_store"
    },
    "workflow_control": {
      "enabled": true,
      "liveness": {
        "event": "agent_beacon",
        "interval_ms": 1000,
        "missed_action": "fail_attempt",
        "required": false,
        "timeout_ms": 5000
      },
      "schema_version": "mn.workflow.runtime_control.v1",
      "source_of_truth": "workflow.steps",
      "state_ledger": {
        "delivery_semantics": "at_least_once_with_idempotency",
        "enabled": true,
        "message_ledger": true,
        "persisted_field": "workflow_state"
      }
    }
  },
  "mode": "explicit"
}
